  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.16.5",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/webpack": "5.28.5",
    "rollup": "4.22.5",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@decky/api": "1.1.3",
    "react-icons": "5.3.0",
    "tslib": "2.7.0"
  }
}
